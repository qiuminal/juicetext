<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab-strip background. Uses the toolbar/primary surface colour with a hairline bottom edge, so the
  strip reads as part of the app bar while the active tab (which uses the editor background) clearly
  breaks away from it. A layer-list avoids an extra View in the hierarchy.

  The edge colour is a fixed translucent grey rather than ?android:attr/textColorTertiary, because
  that attribute only exists from API 26 and this app supports API 23.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorPrimary" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#33808080" />
        </shape>
    </item>
</layer-list>
