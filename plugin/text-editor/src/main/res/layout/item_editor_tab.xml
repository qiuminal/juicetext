<?xml version="1.0" encoding="utf-8"?>
<!--
  One editor tab. The active tab is drawn with the editor's background colour plus an accent
  underline, so it visually merges with the text area; inactive tabs stay transparent against the
  strip and are separated by a hairline divider. Everything here is a plain view/shape — no custom
  drawing — to keep binding cheap when many tabs are open.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tabRoot"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:background="@drawable/bg_tab_inactive"
    android:minWidth="96dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="2dp">

        <!-- wrap_content (not 0dp+weight): a weighted child inside a wrap_content parent
             re-measures to a different width on rebind, which made tabs visibly stretch and
             shrink when switching. Sizing to the text keeps each tab's width stable. -->
        <TextView
            android:id="@+id/tabName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="140dp"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            tools:text="config.yaml" />

        <TextView
            android:id="@+id/tabDirtyDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:gravity="center"
            android:textColor="?attr/colorAccent"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="●"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tabClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/close_tab"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Active-tab underline; hidden on inactive tabs. -->
    <View
        android:id="@+id/tabIndicator"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorAccent"
        android:visibility="invisible" />

    <!-- Hairline separator between adjacent tabs; hidden on the active tab.
         textColorSecondary (not textColorTertiary, which is API 26+) keeps minSdk 23 happy. -->
    <View
        android:id="@+id/tabDivider"
        android:layout_width="1dp"
        android:layout_height="18dp"
        android:layout_gravity="end|center_vertical"
        android:alpha="0.35"
        android:background="?android:attr/textColorSecondary" />

</FrameLayout>
